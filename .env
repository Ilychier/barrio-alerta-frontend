# ============================================================
# Barrio Alerta Frontend - Desarrollo local
# ============================================================
# El backend Spring Boot corre en localhost:8080 (mvn spring-boot:run)
# ============================================================

EXPO_PUBLIC_REPOSITORY_TYPE=api
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Modo emergencia: la app abre en la landing de mascotas (formulario rápido + feed)
# La landing de marketing original queda oculta pero intacta.
# Revertir: EXPO_PUBLIC_MODO_EMERGENCIA=false (o eliminar la línea)
EXPO_PUBLIC_MODO_EMERGENCIA=true
